# Copiá este archivo como .env.local y completá los valores de tu proyecto de Supabase
# (Supabase > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# La dirección pública del sitio, sin barra al final. Se usa para los códigos QR y las vistas previas al compartir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
